{
  "buildCommand": "pnpm --filter @workspace/baksa-tales run build",
  "outputDirectory": "artifacts/baksa-tales/dist/public",
  "installCommand": "pnpm install --frozen-lockfile",
  "framework": null,
  "buildEnv": {
    "PORT": "3000",
    "BASE_PATH": "/"
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
